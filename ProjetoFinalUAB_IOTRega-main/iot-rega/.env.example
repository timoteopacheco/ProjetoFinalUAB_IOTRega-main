# Credenciais usadas pelo docker-compose.
# Copiar para .env e substituir pelos valores reais:
#   cp .env.example .env
#
# O ficheiro .env NÃO deve ser versionado (ver .gitignore).

DB_NAME=iotrega
DB_USER=postgres

# Gerar uma password forte, por exemplo:
#   openssl rand -base64 24
DB_PASSWORD=

# Segredo usado para assinar os tokens JWT. Gerar com:
#   openssl rand -hex 32
JWT_SECRET=
